# 이 파일을 backend/.env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.

# 루트 .env 의 POSTGRES_PORT 와 같은 포트를 쓴다 (기본 5433)
DB_URL=jdbc:postgresql://localhost:5433/worklog
DB_USER=worklog
DB_PASSWORD=worklog

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
#   Homepage URL:              http://localhost:5173
#   Authorization callback URL: http://localhost:8080/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (AES-256)
ENCRYPTION_KEY=

WORKLOG_LLM_PROVIDER=mock
GEMMA4_API_KEY=
QWEN3_API_KEY=

# GitHub 과 무관한 관리자 계정. 기동 시 없으면 만들고, 이미 있으면 손대지 않는다.
# 첫 로그인에서 비밀번호를 바꾸게 한다.
WORKLOG_ADMIN_ID=admin
WORKLOG_ADMIN_PASSWORD=admin1234

# 개인 GitHub 계정에 관리자 권한을 얹는 옛 방식 (쉼표 구분). 위 계정이 있으면 비워 둔다.
WORKLOG_ADMIN_LOGINS=

# 회원 조회 API (와플) — 로그인·직원 목록의 기준.
# 주소도 키도 사내 정보다. 값은 backend/.env 에만 두고 절대 커밋하지 않는다.
WAPLE_API_BASE_URL=
WAPLE_API_KEY=
# 회사가 둘인데 이름이 같다. 사원 목록이 완전히 다르다 — coSeq 1 은 16명, 29 는 33명이고
# 사번 구간도 겹치지 않는다. 실제 회사는 29 다 (9/10 확인, TODO_0910 §5-1 답).
WAPLE_COMPANY_SEQ=29
# 사내망 밖에서 개발할 때 쓰는 임시 사원 목록 (형식: 9999:홍길동,9998:김철수).
# WAPLE_API_BASE_URL 이 있으면 쓰이지 않는다.
# 사내 API 를 붙이기 전 로그인·직원 목록을 눌러 보려면 여기에 임시 사원을 적는다.
# 비워 두면 사원 목록이 비어 사원번호 로그인이 전부 실패한다.
WAPLE_FALLBACK_EMPLOYEES=9998:테스트사원,9999:데모사원

MATTERMOST_WEBHOOK_URL=
# 채널에서 "OOO의 오늘 업무일지 요약해줘" 로 물어보는 기능. 둘 중 하나.
# (1) Outgoing Webhook 의 token — Mattermost 관리자가 켜 줘야 쓸 수 있다
MATTERMOST_OUTGOING_TOKEN=
# (2) 봇 계정 — 일반 회원 계정 하나면 된다. 계정을 채널에 넣어 두면 그 채널을 읽는다
MATTERMOST_BASE_URL=http://mattermost.example.com:8065
MATTERMOST_BOT_LOGIN_ID=
MATTERMOST_BOT_PASSWORD=
FRONTEND_URL=http://localhost:5173
DRAFT_SCHEDULE_CRON="0 0 18 * * *"
GITHUB_SYNC_CRON="0 */10 * * * *"
