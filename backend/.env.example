# 이 파일을 backend/.env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.

# 루트 .env 의 POSTGRES_PORT 와 같은 포트를 쓴다 (기본 5433)
DB_URL=jdbc:postgresql://localhost:5433/worklog
DB_USER=worklog
DB_PASSWORD=worklog

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
#   Homepage URL:              http://localhost:5173
#   Authorization callback URL: http://localhost:8080/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (AES-256)
ENCRYPTION_KEY=

WORKLOG_LLM_PROVIDER=mock
GEMMA4_API_KEY=
QWEN3_API_KEY=

# 관리자 콘솔에 들어갈 수 있는 GitHub 로그인 (쉼표 구분)
WORKLOG_ADMIN_LOGINS=

# 사내 회원 조회 API (와플). 사내망 주소와 키 — 커밋 금지
WAPLE_API_BASE_URL=
WAPLE_API_KEY=
# 회사가 둘인데 이름이 같아 번호로 정한다
WAPLE_COMPANY_SEQ=

MATTERMOST_WEBHOOK_URL=
FRONTEND_URL=http://localhost:5173
DRAFT_SCHEDULE_CRON="0 0 18 * * *"
GITHUB_SYNC_CRON="0 */10 * * * *"
