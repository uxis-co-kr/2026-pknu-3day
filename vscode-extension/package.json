{
  "name": "worklog-drafter",
  "displayName": "WorkLog Drafter",
  "description": "커밋되지 않은 작업과 오늘의 계획을 모아 WorkLog Drafter 서버로 보낸다.",
  "version": "0.2.2",
  "publisher": "withly",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/uxis-co-kr/2026-pknu-3day.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "worklog.recordPlan",
        "title": "WorkLog: 오늘 계획 작성·수정",
        "icon": "$(edit)"
      },
      {
        "command": "worklog.sendNow",
        "title": "WorkLog: 지금 전송",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "worklog.refresh",
        "title": "WorkLog: 새로고침",
        "icon": "$(refresh)"
      },
      {
        "command": "worklog.setApiKey",
        "title": "WorkLog: 서버 주소·API Key 입력",
        "icon": "$(key)"
      },
      {
        "command": "worklog.setServerUrl",
        "title": "WorkLog: 서버 주소 설정",
        "icon": "$(server)"
      }
    ],
    "configuration": {
      "title": "WorkLog Drafter",
      "properties": {
        "worklog.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "백엔드 주소. /api 는 붙이지 않는다. 서버를 띄운 PC 가 따로 있으면 'WorkLog: 서버 주소 설정' 으로 바꾼다 — 기본값은 자기 컴퓨터를 가리킨다."
        },
        "worklog.apiKey": {
          "type": "string",
          "default": "",
          "description": "설정 > API Key 에서 발급한 개인 키 (wl_ 로 시작)."
        },
        "worklog.intervalMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "자동 전송 주기(분). AI 대화는 그 사이에도 쌓이므로 너무 길면 서버 값이 낡는다."
        },
        "worklog.collectDiff": {
          "type": "boolean",
          "default": true,
          "description": "미커밋 diff 본문을 함께 보낼지. 끄면 파일 경로와 변경 줄 수만 보낸다."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worklog",
          "title": "WorkLog Drafter",
          "icon": "media/worklog.svg"
        }
      ]
    },
    "views": {
      "worklog": [
        {
          "id": "worklog.session",
          "name": "오늘 보낼 내용"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "worklog.sendNow",
          "when": "view == worklog.session",
          "group": "navigation@1"
        },
        {
          "command": "worklog.refresh",
          "when": "view == worklog.session",
          "group": "navigation@2"
        },
        {
          "command": "worklog.setServerUrl",
          "when": "view == worklog.session",
          "group": "navigation@3"
        },
        {
          "command": "worklog.setApiKey",
          "when": "view == worklog.session",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "worklog.recordPlan",
          "when": "view == worklog.session && viewItem == worklog.plan",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies",
    "preview": "node scripts/preview.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
